# Super JinX Panel: optional Railway Variables. Nothing here is required.
# First login: admin / admin (first boot only). Change it right away: Settings > Change password.

# Name shown before every config in the user's app
CONFIG_TITLE=Vortex

# Subscription path: https://YOUR-DOMAIN/<SUBSCRIPTION_PATH>/<token>  (keep it on sub: the self-repair page is built for /sub/)
SUBSCRIPTION_PATH=sub

# Only if you use your own domain / Cloudflare instead of *.up.railway.app
# PUBLIC_DOMAIN=panel.example.com

# Clean Cloudflare IPs for the config address, comma separated (one is picked at random per subscription fetch).
# Only works when PUBLIC_DOMAIN is a domain proxied by Cloudflare (orange cloud, SSL mode Full). SNI and Host stay on the domain.
# CLEAN_IPS=104.16.1.1,104.17.2.2

# Demo reseller (reseller / reseller, 50 GB). Set to off to skip it
DEMO_RESELLER=on
